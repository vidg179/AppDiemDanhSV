# Cấu hình bí mật cho server. Copy file này thành deploy/.env rồi điền.
# deploy/.env KHÔNG đưa lên git, KHÔNG nộp cho thầy.

ASPNETCORE_ENVIRONMENT=Production

# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng: openssl rand -base64 48
Jwt__Key=

# Gmail gửi OTP: bật Xác minh 2 bước, tạo App password tại https://myaccount.google.com/apppasswords
Smtp__User=
Smtp__Password=

# true = trả mã OTP trong response (field devCode) để demo khi không nhận được email. Tắt khi dùng thật.
Otp__ReturnCodeInResponse=false

# Web client ID của Google, chỉ cần khi làm đăng nhập Google.
# Google__ClientIds__0=xxxx.apps.googleusercontent.com
